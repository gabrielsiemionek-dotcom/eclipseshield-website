---
// Simple page shell: dark title band plus a readable content column.
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  eyebrow?: string;
  intro?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}
const { heading, eyebrow, intro, ...rest } = Astro.props;
---

<BaseLayout {...rest}>
  <PageHero heading={heading} eyebrow={eyebrow} intro={intro} />
  <div class="section page-body">
    <div class="wrap prose">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .page-body {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .prose {
    max-width: 46rem;
  }
  .prose :global(h2) {
    font-size: 1.5rem;
    margin-top: 2em;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
</style>
