---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FilmVisual from '../../components/FilmVisual.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { services, getService, serviceHref, type ServiceContent } from '../../data/services';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../lib/schema';
import { site } from '../../config/site';
import terracePhoto from '../../assets/photos/glass-room-terrace.jpg';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: ServiceContent;
}
const { service: s } = Astro.props;

// Real job photos, where we have one that fits the service.
const photos: Record<string, { src: ImageMetadata; alt: string }> = {
  'solar-control-window-film': {
    src: terracePhoto,
    alt: 'View out through the floor-to-ceiling glass of a garden room onto a terrace with table and chairs',
  },
};
const photo = photos[s.slug];

const crumbs = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: serviceHref(s.slug), label: s.title },
];
const related = s.related.map(getService).filter((r): r is ServiceContent => Boolean(r));
---

<BaseLayout
  title={s.metaTitle}
  description={s.metaDescription}
  schema={[serviceSchema(s), breadcrumbSchema(crumbs), faqSchema(s.faqs)]}
>
  <PageHero heading={s.h1} eyebrow="Window film services" intro={s.intro} crumbs={crumbs} ctas>
    {
      photo ? (
        <Picture
          slot="media"
          src={photo.src}
          alt={photo.alt}
          formats={['avif', 'webp']}
          widths={[360, 540, 720, 960]}
          sizes="(min-width: 32rem) 30rem, calc(100vw - 2rem)"
          layout="none"
          priority
        />
      ) : (
        <FilmVisual slot="media" variant={s.visual} />
      )
    }
  </PageHero>

  <!-- Benefits -->
  <section class="section" aria-labelledby="benefits-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What it does</p>
        <h2 id="benefits-title">Why choose {s.title.toLowerCase()}</h2>
      </div>
      <ul class="benefits">
        {
          s.benefits.map((b) => (
            <li class="card">
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Where it's used -->
  <section class="section section--mist" aria-labelledby="uses-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Where it’s used</p>
        <h2 id="uses-title">For homes and businesses</h2>
      </div>
      <div class="grid grid--2">
        <div class="card">
          <div class="icon-badge"><Icon name="home" /></div>
          <h3>In homes</h3>
          <ul class="ticks">{s.homes.map((h) => <li>{h}</li>)}</ul>
          <a href="/homes/">Window film for homes</a>
        </div>
        <div class="card">
          <div class="icon-badge"><Icon name="building" /></div>
          <h3>In businesses</h3>
          <ul class="ticks">{s.businesses.map((b) => <li>{b}</li>)}</ul>
          <a href="/businesses/">Window film for businesses</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Options and honest notes -->
  <section class="section" aria-labelledby="options-title">
    <div class="wrap options">
      <div>
        <p class="eyebrow">Your options</p>
        <h2 id="options-title">Choosing the right film</h2>
        <dl class="options__list">
          {
            s.options.map((o) => (
              <div>
                <dt>{o.title}</dt>
                <dd>{o.text}</dd>
              </div>
            ))
          }
        </dl>
        <p>
          We fit {site.filmBrand} window film. Not sure which option is right? We’ll talk you through them at your free
          survey or when we quote.
        </p>
      </div>
      <aside class="good-to-know" aria-labelledby="gtk-title">
        <h2 id="gtk-title">Good to know</h2>
        <ul>{s.goodToKnow.map((g) => <li>{g}</li>)}</ul>
      </aside>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--mist" aria-labelledby="faq-title">
    <div class="wrap faq">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-title">Common questions</h2>
        <p class="lead">More questions? <a href="/#faq">See our general FAQ</a> or <a href="/quote/">ask us directly</a>.</p>
      </div>
      <FaqList faqs={s.faqs} />
    </div>
  </section>

  <!-- Related -->
  <section class="section" aria-labelledby="related-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="related-title">Related services</h2>
      </div>
      <div class="grid grid--3">
        {related.map((r) => <ServiceCard service={r} />)}
      </div>
    </div>
  </section>

  <CtaBand title={`Get a free quote for ${s.title.toLowerCase()}`} />
</BaseLayout>

<style>
  .benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .benefits h3 {
    margin-bottom: 0.4rem;
  }
  .benefits p {
    color: var(--text-2);
  }
  .options {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  .options__list {
    margin: 0 0 1.5rem;
    display: grid;
    gap: 1.1rem;
  }
  .options__list dt {
    font-weight: 750;
    font-size: 1.08rem;
  }
  .options__list dd {
    margin: 0.2rem 0 0;
    color: var(--text-2);
  }
  .good-to-know {
    background: var(--black);
    color: var(--silver);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-left: 4px solid var(--gold);
  }
  .good-to-know h2 {
    color: var(--paper);
    font-size: 1.35rem;
  }
  .good-to-know ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.9rem;
  }
  .good-to-know li::marker {
    color: var(--gold);
  }
  .faq {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 62rem) {
    .options {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 4rem;
    }
    .faq {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 4rem;
    }
  }
</style>
