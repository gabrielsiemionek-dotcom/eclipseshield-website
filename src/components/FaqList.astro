---
import type { Faq } from '../data/services';

interface Props {
  faqs: Faq[];
}
const { faqs } = Astro.props;
---

<div class="faq-list">
  {
    faqs.map((f) => (
      <details class="faq-list__item">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq-list {
    border-top: 1px solid var(--line);
  }
  .faq-list__item {
    border-bottom: 1px solid var(--line);
  }
  .faq-list__item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0;
    font-weight: 700;
    font-size: 1.08rem;
  }
  .faq-list__item summary::-webkit-details-marker {
    display: none;
  }
  .faq-list__item summary::after {
    content: '+';
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--mist);
    color: var(--gold-deep);
    font-size: 1.3rem;
    font-weight: 500;
  }
  .faq-list__item[open] summary::after {
    content: '−';
  }
  .faq-list__item p {
    color: var(--text-2);
    padding-right: 3rem;
    margin-bottom: 1.25rem;
  }
</style>
