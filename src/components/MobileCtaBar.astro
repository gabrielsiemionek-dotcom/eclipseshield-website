---
import Icon from './Icon.astro';
import { site, telHref } from '../config/site';

// On the quote page itself, offer a call instead of a link back to the form.
const onQuotePage = Astro.url.pathname.startsWith('/quote/');
---

<div class="mobile-cta">
  {
    onQuotePage && site.phone ? (
      <a class="btn btn--ghost mobile-cta__main" href={telHref(site.phone)}>
        <Icon name="phone" />
        Prefer to talk? Call {site.phone}
      </a>
    ) : (
      <a class="btn btn--gold mobile-cta__main" href="/quote/">
        Get a free quote
      </a>
    )
  }
  {
    !onQuotePage &&
      (site.phone ? (
        <a class="mobile-cta__icon" href={telHref(site.phone)}>
          <Icon name="phone" label={`Call ${site.phone}`} />
        </a>
      ) : (
        <a class="mobile-cta__icon" href={`mailto:${site.email}`}>
          <Icon name="mail" label={`Email ${site.email}`} />
        </a>
      ))
  }
</div>

<style>
  .mobile-cta {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: flex;
    gap: 0.6rem;
    padding: 0.7rem var(--gutter) calc(0.7rem + env(safe-area-inset-bottom));
    background: rgb(10 10 11 / 0.97);
    border-top: 1px solid rgb(201 161 74 / 0.25);
  }
  .mobile-cta__main {
    flex: 1;
  }
  .mobile-cta__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    flex: none;
    border-radius: 50%;
    border: 2px solid rgb(255 255 255 / 0.35);
    color: var(--paper);
  }
  .mobile-cta__icon :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }
  @media (min-width: 48rem) {
    .mobile-cta {
      display: none;
    }
  }
</style>
