---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site, telHref } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <Logo id="logo-f" />
      <p>Professional {site.filmBrand} window film for homes and businesses. {site.serviceAreaLine}.</p>
      <a class="btn btn--gold" href="/quote/">Get a free quote</a>
    </div>

    <nav aria-label="Footer">
      <h2 class="site-footer__title">Explore</h2>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li><a href="/quote/">Free quote</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="site-footer__title">Get in touch</h2>
      <ul class="site-footer__contact">
        <li>
          <Icon name="mail" />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        {
          site.phone && (
            <li>
              <Icon name="phone" />
              <a href={telHref(site.phone)}>{site.phone}</a>
            </li>
          )
        }
        <li>
          <Icon name="pin" />
          <span>Based in {site.base}, {site.region}</span>
        </li>
        <li>
          <Icon name="clock" />
          <span>{site.hours}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="wrap site-footer__legal">
    <p>
      &copy; {year} {site.legalName}. Registered in {site.registeredIn}, company number {site.companyNumber}.
      {site.registeredOffice && <>Registered office: {site.registeredOffice}.</>}
    </p>
    <ul>
      <li><a href="/privacy/">Privacy policy</a></li>
      <li><a href="/terms/">Terms</a></li>
      <li><button type="button" class="site-footer__cookie" data-cookie-settings hidden>Cookie settings</button></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--black);
    color: var(--silver-dim);
    padding-top: clamp(3rem, 6vw, 4.5rem);
    font-size: 0.97rem;
  }
  .site-footer a:not(.btn):not(:global(.logo)) {
    color: var(--silver);
    text-decoration: none;
  }
  .site-footer a:not(.btn):not(:global(.logo)):hover {
    color: var(--gold-hi);
    text-decoration: underline;
  }
  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
    padding-bottom: 2.5rem;
  }
  .site-footer__brand p {
    margin: 1.25rem 0 1.5rem;
    max-width: 30rem;
  }
  .site-footer__title {
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1rem;
  }
  .site-footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .site-footer ul a {
    display: inline-block;
    padding-block: 0.15rem;
  }
  .site-footer__contact li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }
  .site-footer__contact :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    margin-top: 0.3rem;
    color: var(--gold);
  }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    border-top: 1px solid var(--graphite);
    padding-block: 1.5rem;
    font-size: 0.88rem;
  }
  .site-footer__legal p {
    margin: 0;
  }
  .site-footer__cookie {
    background: none;
    border: 0;
    padding: 0.15rem 0;
    font: inherit;
    color: var(--silver);
    cursor: pointer;
  }
  .site-footer__cookie:hover {
    color: var(--gold-hi);
    text-decoration: underline;
  }
  .site-footer__cookie[hidden] {
    display: none;
  }
  .site-footer .site-footer__legal ul {
    display: flex;
    gap: 1.25rem;
  }
  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: 2fr 1fr 1.4fr;
    }
  }
</style>
