---
import Icon from './Icon.astro';
import { site, telHref } from '../config/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Get a free, no-obligation quote',
  text = 'Tell us about your windows. Add photos if you have them, and we will reply the same day.',
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-band-title">
  <div class="wrap cta-band__inner">
    <div>
      <h2 id="cta-band-title">{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--gold" href="/quote/">
        Get a free quote
        <Icon name="arrow" />
      </a>
      {
        site.phone ? (
          <a class="btn btn--ghost" href={telHref(site.phone)}>
            <Icon name="phone" />
            Call {site.phone}
          </a>
        ) : (
          <a class="btn btn--ghost" href={`mailto:${site.email}`}>
            <Icon name="mail" />
            Email us
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta-band {
    background:
      radial-gradient(60rem 30rem at 85% 0%, rgb(201 161 74 / 0.18), transparent 60%),
      var(--black);
    color: var(--silver);
    padding-block: clamp(3rem, 7vw, 5rem);
    border-top: 1px solid rgb(201 161 74 / 0.2);
  }
  .cta-band__inner {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  .cta-band h2 {
    color: var(--paper);
    margin-bottom: 0.4em;
  }
  .cta-band p {
    margin: 0;
    max-width: 36rem;
  }
  @media (min-width: 56rem) {
    .cta-band__inner {
      grid-template-columns: 1fr auto;
      gap: 3rem;
    }
  }
</style>
