---
// Dark page header used on inner pages. Optional `media` slot shows a picture or illustration alongside.
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';
import { site, telHref } from '../config/site';

interface Props {
  heading: string;
  eyebrow?: string;
  intro?: string;
  crumbs?: { href: string; label: string }[];
  ctas?: boolean;
  quoteHref?: string;
}
const { heading, eyebrow, intro, crumbs, ctas = false, quoteHref = '/quote/' } = Astro.props;
const hasMedia = Astro.slots.has('media');
---

<section class:list={['page-hero', { 'page-hero--media': hasMedia }]}>
  <div class="wrap page-hero__grid">
    <div>
      {crumbs && <Breadcrumbs items={crumbs} />}
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{heading}</h1>
      {intro && <p class="lead">{intro}</p>}
      {
        ctas && (
          <div class="btn-row">
            <a class="btn btn--gold" href={quoteHref}>
              Get a free quote
              <Icon name="arrow" />
            </a>
            {site.phone && (
              <a class="btn btn--ghost" href={telHref(site.phone)}>
                <Icon name="phone" />
                Call {site.phone}
              </a>
            )}
          </div>
        )
      }
    </div>
    {
      hasMedia && (
        <div class="page-hero__media">
          <slot name="media" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    background:
      radial-gradient(40rem 24rem at 95% -20%, rgb(201 161 74 / 0.2), transparent 60%),
      var(--black);
    color: var(--silver);
    padding-block: clamp(2rem, 6vw, 4.5rem);
  }
  .page-hero h1 {
    color: var(--paper);
    max-width: 48rem;
  }
  .page-hero .eyebrow {
    color: var(--gold);
  }
  .page-hero .lead {
    color: var(--silver);
  }
  .page-hero .btn-row {
    margin-top: 1.75rem;
  }
  .page-hero__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .page-hero__media {
    max-width: 30rem;
    width: 100%;
    justify-self: center;
  }
  .page-hero__media :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid rgb(201 161 74 / 0.35);
  }
  @media (min-width: 62rem) {
    .page-hero--media .page-hero__grid {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 4rem;
    }
  }
</style>
