---
// Vector version of the Eclipse Shield mark (eclipse arc, sun flare, shield).
interface Props {
  class?: string;
  id?: string;
}
const { class: className, id = 'lm' } = Astro.props;
---

<svg class={className} viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <linearGradient id={`${id}-g`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#8c6a2a"></stop>
      <stop offset="0.45" stop-color="#ecd08a"></stop>
      <stop offset="1" stop-color="#b58a35"></stop>
    </linearGradient>
    <radialGradient id={`${id}-f`}>
      <stop offset="0" stop-color="#fff3cf"></stop>
      <stop offset="0.35" stop-color="#f2c76a" stop-opacity="0.8"></stop>
      <stop offset="1" stop-color="#f2c76a" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <path d="M7.6 44.9A26 26 0 1 1 57.6 40.5" fill="none" stroke={`url(#${id}-g)`} stroke-width="1.6" stroke-linecap="round"></path>
  <circle cx="51.9" cy="19.3" r="7" fill={`url(#${id}-f)`}></circle>
  <circle cx="51.9" cy="19.3" r="1.6" fill="#fff6dc"></circle>
  <path d="M32 19.5l11 4v9.5c0 7.6-4.6 12.6-11 15.5-6.4-2.9-11-7.9-11-15.5v-9.5z" fill="none" stroke={`url(#${id}-g)`} stroke-width="2.4" stroke-linejoin="round"></path>
</svg>
